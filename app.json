{
  "expo": {
    "name": "AI Calorie & Protein Tracker",
    "slug": "ai-calorie-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "aicalorietracker",
    "userInterfaceStyle": "automatic",
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.foodapp.aicalorietracker",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow AI Calorie Tracker to access your photos to analyze food."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow AI Calorie Tracker to use camera to scan food."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "cf644079-fab3-4b28-a55f-f6d7709744c2"
      }
    },
    "owner": "naikar"
  }
}
